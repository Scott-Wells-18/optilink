{
  "name": "optilink-reports",
  "version": "1.0.0",
  "private": true,
  "description": "OptiLink electrical inspection reporting dashboard",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && next start -p ${PORT:-3000}",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "lint": "next lint"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@types/pdfkit": "^0.17.6",
    "jszip": "^3.10.2",
    "next": "15.5.25",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2",
    "pngjs": "^7.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.10.5",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
