// OptiLink — electrical inspection reporting
// Standards basis: AS/NZS 3000 (Wiring Rules) and AS/NZS 3017 (verification).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Company settings — a single row (id = "singleton") holding branding and the
// defaults that go on every report.
// ---------------------------------------------------------------------------

model Settings {
  id String @id @default("singleton")

  companyName   String  @default("OptiLink")
  tradingName   String?
  abn           String?
  licenceNumber String?
  phone         String?
  email         String?
  website       String?
  addressLine1  String?
  addressLine2  String?
  suburb        String?
  state         String? @default("NSW")
  postcode      String?

  // Branding
  primaryColour  String        @default("#0B3B60")
  accentColour   String        @default("#F5A623")
  logoFileId     String?
  logoMarkFileId String?
  logo           UploadedFile? @relation("SettingsLogo", fields: [logoFileId], references: [id], onDelete: SetNull)
  logoMark       UploadedFile? @relation("SettingsLogoMark", fields: [logoMarkFileId], references: [id], onDelete: SetNull)

  // Report defaults
  defaultTechnicianName    String?
  defaultTechnicianLicence String?
  reportFooterText         String?
  reportIntroText          String?
  nextReportNumber         Int     @default(1)

  /**
   * RCD limits, overriding the defaults in lib/standards/rcd. Held here so
   * they can be corrected against the current edition of the standard without
   * a deploy.
   */
  rcdLimits         Json?
  /**
   * A reading at or above this share of its limit is a concern, not a pass.
   */
  rcdConcernPercent Int   @default(80)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Files
// ---------------------------------------------------------------------------

model UploadedFile {
  id           String   @id @default(cuid())
  originalName String
  storedName   String   @unique
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  createdAt    DateTime @default(now())

  thermalFor        ThermalFinding[]  @relation("ThermalImage")
  visualFor         ThermalFinding[]  @relation("VisualImage")
  photos            Photo[]
  observationPhotos Observation[]
  settingsLogo      Settings[]        @relation("SettingsLogo")
  settingsLogoMark  Settings[]        @relation("SettingsLogoMark")
  issuePhotos       IssuePhoto[]
  jobPhotos         JobPhoto[]
  rcdSources        RcdTestRun[]      @relation("RcdSource")
  safetyTemplates   SafetyTemplate[]  @relation("SafetyTemplateFile")
  signatures        Signature[]       @relation("SignatureFile")
  safetyDocSources  SafetyDoc[]       @relation("SafetyDocSource")
  powerSources      PowerAnalysis[]   @relation("PowerAnalysisSource")
  ampSources        AmpRecording[]    @relation("AmpRecordingSource")
  profileSignatures Profile[]         @relation("ProfileSignature")
  equipmentCerts    TestEquipment[]   @relation("TestEquipmentCert")
  equipmentPhotos   TestEquipment[]   @relation("TestEquipmentPhoto")
  taggingReference  TaggingSettings[] @relation("TaggingReference")
  taggingSnapshots  TagReport[]       @relation("TagReportSource")
  gatePhotos        GatePhoto[]       @relation("GatePhoto")
  installSources    InstallReport[]   @relation("InstallSource")
}

/**
 * A piece of our own test gear, and the certificate that says it reads true.
 * Not equipment at a client's site — that is `Equipment`, which belongs to a
 * Site. This is the instrument in the van: the analyser, the RCD tester, the
 * camera. A report that quotes a measurement names the instrument that took
 * it and carries its calibration certificate, which is what makes the
 * measurement worth anything to anyone reading it afterwards.
 */
model TestEquipment {
  id       String  @id @default(cuid())
  name     String
  serialNo String?
  modelNo  String?

  /**
   * The calibration certificate, kept byte for byte and bound into reports.
   */
  certFileId String?
  certFile   UploadedFile? @relation("TestEquipmentCert", fields: [certFileId], references: [id], onDelete: SetNull)

  /**
   * The dates off the certificate, read from it where they can be and always
   * correctable by hand. Held here rather than read afresh every time a report
   * is built: a scanned certificate has to be put through character
   * recognition to be read at all, which is slow and is a reading rather than
   * a quotation, so it is done once and shown to the person who filed it.
   */
  calibratedOn DateTime? @db.Date
  expiresOn    DateTime? @db.Date

  /**
   * A photograph of the instrument. Optional.
   */
  photoFileId String?
  photoFile   UploadedFile? @relation("TestEquipmentPhoto", fields: [photoFileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  powerRuns      PowerAnalysis[]
  ampReports     AmpReport[]
  rcdReports     RcdReport[]
  installReports InstallReport[] @relation("InstallInstrument")
}

// ---------------------------------------------------------------------------
// Clients
// ---------------------------------------------------------------------------

/**
 * A key an outside assistant works through.
 * The app itself is behind one shared password, which is fine for a person at
 * a keyboard and no use at all for a machine: there is no way to tell one
 * caller from another, and no way to stop one without stopping everybody. A
 * token is issued to one thing, is named so it is obvious what it is for, and
 * can be revoked on its own.
 * Only the hash is kept. The token itself is shown once when it is made and
 * is not recoverable, so a copy of this table is not a copy of the keys.
 */
model ApiToken {
  id     String @id @default(cuid())
  /**
   * What it is for, e.g. "ChatGPT".
   */
  name   String
  /**
   * SHA-256 of the token. The token itself is never stored.
   */
  hash   String @unique
  /**
   * The first few characters, so a token can be recognised in a list.
   */
  prefix String

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([revokedAt])
}

model Client {
  id           String   @id @default(cuid())
  name         String
  contactName  String?
  email        String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  suburb       String?
  state        String?  @default("NSW")
  postcode     String?
  notes        String?
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reports Report[]
  sites   Site[]

  @@index([name])
}

// A client can have any number of sites, and each site its own people.

model Site {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name      String
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipment      Equipment[]
  inspections    Inspection[]
  contacts       Contact[]
  jobs           Job[]
  rcdRuns        RcdTestRun[]
  rcdReports     RcdReport[]
  safetyDocs     SafetyDoc[]
  powerRuns      PowerAnalysis[]
  ampReports     AmpReport[]
  tagReports     TagReport[]
  gateReports    GateReport[]
  gateAssets     GateAsset[]
  installReports InstallReport[]

  @@index([clientId])
}

/**
 * Who to speak to at a site. A site can have several.
 */
model Contact {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  name  String
  email String?
  phone String?

  createdAt DateTime @default(now())

  /**
   * The reports addressed to them.
   */
  inspections    Inspection[]
  jobs           Job[]
  rcdReports     RcdReport[]
  powerRuns      PowerAnalysis[]
  ampReports     AmpReport[]
  safetyDocs     SafetyDoc[]
  gatesNotified  GateReport[]    @relation("GateNotified")
  gatesSignedFor GateReport[]    @relation("GateClientRep")
  installReports InstallReport[] @relation("InstallContact")

  @@index([siteId])
}

enum EquipmentKind {
  SWITCHBOARD
  APPLIANCE
  MOTOR
}

model Equipment {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  kind EquipmentKind @default(APPLIANCE)
  name String

  /**
   * Appliances and motors. Shown when opened, to keep the tree short.
   */
  description String?

  /**
   * Motors only, and optional even then — e.g. "32 A" or "18.5 kW".
   */
  circuitLoading String?

  /**
   * Switchboards only — the drawn layout of the board: how many rows, what is
   * in each position, and any RCDs sitting outside the main grid. Free-form
   * shape, never queried, so it lives as JSON rather than its own tables.
   */
  board Json?

  /**
   * Switchboards only — where the board is fed from, over what, and how far.
   * What a power analysis needs to say anything about headroom: the size of
   * the device in front of the board, the cables that reach it, and the run.
   * Free-form shape, never queried, so it lives as JSON. See `lib/supply.ts`.
   */
  supply Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issues     Issue[]
  rcdRuns    RcdTestRun[]
  powerRuns  PowerAnalysis[]
  ampReports AmpReport[]

  @@index([siteId])
}

// ---------------------------------------------------------------------------
// Thermal inspections
//
// A site is surveyed over and over, so the findings hang off a dated
// inspection rather than the equipment itself: the same breaker can be dusty
// in March, hot in June and repaired in July, and each survey keeps its own
// record and its own photos.
// ---------------------------------------------------------------------------

model Inspection {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  /**
   * Optional — falls back to the date of the survey.
   */
  name String?

  /**
   * The day it was carried out. Starts as today; changed by hand after.
   */
  date DateTime @default(now()) @db.Date

  /**
   * Whose name goes on the report as the site contact.
   * Chosen rather than assumed: a site can have several people on file and the
   * report is addressed to one of them. Nothing is printed where none has been
   * chosen.
   */
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  createdAt  DateTime @default(now())
  /**
   * The profiles named as having prepared this, in the order they are listed.
   * Empty means the director, which is who it was before this could be chosen.
   */
  preparedBy String[]

  issues Issue[]

  @@index([siteId])
  @@index([contactId])
}

enum IssueType {
  DUST_INGRESS
  RISING_TEMPERATURE
  /**
   * Retired — folded into rising temperature. Kept so old findings read.
   */
  TERMINATION_ISSUE
  REPAIRED
}

/**
 * What is behind a rising temperature.
 */
enum IssueCause {
  // Switchboards
  INTERNAL_HEATING
  TERMINAL_CONNECTION
  // Motors
  BEARING
  OVERLOAD
  VENTILATION
  ALIGNMENT
  MOTOR_TERMINAL
  WINDING
}

/**
 * One finding, against one position on one piece of equipment.
 */
model Issue {
  id           String     @id @default(cuid())
  inspectionId String
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  /**
   * Which position: "sectionId:cell:12", "sectionId:extra:0", or "motor".
   */
  slot String

  type  IssueType
  cause IssueCause?

  /**
   * Off the thermogram, in °C: the reference away from the hot spot, and the
   * hot spot itself. The difference between them is the temperature rise, and
   * the rise is what sets the priority — so both are kept and neither is.
   */
  refTemp Float?
  hotTemp Float?

  /**
   * What to do about it, as keys into the catalogue in lib/issues — the words
   * themselves depend on what the position is, so they are built when shown.
   */
  recommendations String[]

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos IssuePhoto[]

  @@index([inspectionId])
  @@index([equipmentId])
}

enum IssuePhotoKind {
  /**
   * Dust ingress needs nothing but a straight photo.
   */
  PLAIN
  THERMAL
  VISUAL
}

model IssuePhoto {
  id      String @id @default(cuid())
  issueId String
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  kind IssuePhotoKind @default(PLAIN)

  fileId String
  file   UploadedFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([issueId])
}

// ---------------------------------------------------------------------------
// Before & after
//
// A day's work at a site, recorded so the client can see what was done. One
// job holds several items, and an item is one discrete piece of work with its
// photos: how it was found, optionally the work in progress, and how it was
// left.
// ---------------------------------------------------------------------------

/**
 * What a works record is for.
 * A completed report says what was done. A rectification report says what is
 * proposed, and is sent with a quotation: it is the same layout and the same
 * photographs, read forwards instead of backwards.
 */
enum JobKind {
  COMPLETED
  RECTIFICATION
}

model Job {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  kind JobKind @default(COMPLETED)

  /**
   * Optional — falls back to the date the work was done.
   */
  name String?

  /**
   * The day the work was carried out.
   */
  date DateTime @default(now()) @db.Date

  /**
   * Anything found but not put right, printed at the back of the report.
   */
  recommendations String[]

  /**
   * Whose name goes on the report as the site contact.
   * Chosen rather than assumed: a site can have several people on file and the
   * report is addressed to one of them. Nothing is printed where none has been
   * chosen.
   */
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  createdAt  DateTime @default(now())
  /**
   * The profiles named as having prepared this, in the order they are listed.
   * Empty means the director, which is who it was before this could be chosen.
   */
  preparedBy String[]

  items JobItem[]

  @@index([siteId])
  @@index([contactId])
}

model JobItem {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  title    String
  location String

  /**
   * The job number on a rectification, where one was given.
   */
  number String?
  /**
   * How it was found.
   */
  found  String
  /**
   * What was done about it.
   */
  done   String

  /**
   * The same two, as they were written.
   * Dot points, bold, italic, underline and the line breaks somebody typed.
   * The plain columns above stay as the mirror of them — they are what decides
   * whether a piece of work is finished, what the contents table ellipsises
   * and what anything searching would look at — so a description written
   * before there was anywhere to put emphasis still reads correctly.
   */
  foundRich Json?
  doneRich  Json?

  /**
   * Hand-ordered within the job.
   */
  position Int @default(0)

  createdAt DateTime @default(now())

  photos JobPhoto[]

  @@index([jobId])
}

enum JobPhotoStage {
  BEFORE
  DURING
  AFTER
}

model JobPhoto {
  id     String  @id @default(cuid())
  itemId String
  item   JobItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  stage JobPhotoStage

  fileId String
  file   UploadedFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([itemId])
}

// ---------------------------------------------------------------------------
// RCD testing
//
// The tester writes its own PDF; we read it, correct it and reissue it. The
// original file is kept byte-for-byte and bound into the back of the report,
// so the instrument's own record is always recoverable.
// ---------------------------------------------------------------------------

/**
 * One issued RCD report, covering however many switchboards were tested.
 * A visit to a depot is one report and several boards, so the boards hang off
 * a dated report rather than each producing a PDF of its own. Each board keeps
 * its own instrument export, its own walk and its own corrections, because
 * those are facts about that board and not about the visit.
 */
model RcdReport {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  name String?
  date DateTime @default(now()) @db.Date

  /**
   * The instrument every board on this visit was tested with.
   */
  instrumentId String?
  instrument   TestEquipment? @relation(fields: [instrumentId], references: [id], onDelete: SetNull)

  /**
   * Whose name goes on the report as the site contact.
   * Chosen rather than assumed: a site can have several people on file and the
   * report is addressed to one of them. Nothing is printed where none has been
   * chosen.
   */
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  createdAt  DateTime @default(now())
  /**
   * The profiles named as having prepared this, in the order they are listed.
   * Empty means the director, which is who it was before this could be chosen.
   */
  preparedBy String[]

  updatedAt DateTime @updatedAt

  tests RcdTestRun[]

  @@index([siteId])
  @@index([instrumentId])
  @@index([contactId])
}

model RcdTestRun {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  /**
   * The report this board belongs to. Absent on runs filed before reports.
   */
  reportId String?
  report   RcdReport? @relation(fields: [reportId], references: [id], onDelete: Cascade)

  /**
   * The board that was tested.
   */
  equipmentId String?
  equipment   Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)

  name String?
  date DateTime @default(now()) @db.Date

  /**
   * The tester's own export, untouched.
   */
  sourceFileId String?
  sourceFile   UploadedFile? @relation("RcdSource", fields: [sourceFileId], references: [id], onDelete: SetNull)

  /**
   * The raw parse, so a report can be rebuilt without the file being re-read.
   */
  parsed Json?

  /**
   * How the tests were walked, and which positions were tested twice.
   */
  corrections Json?

  /**
   * Answers to the checks the instrument cannot record.
   */
  checklist Json?

  /**
   * Disagreements between the file and the site, accepted by the operator.
   */
  mismatches String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  results RcdResult[]

  @@index([siteId])
  @@index([reportId])
}

model RcdResult {
  id    String     @id @default(cuid())
  runId String
  run   RcdTestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  /**
   * Which position on the board, e.g. "main:cell:12". Null when unmatched.
   */
  slot  String?
  /**
   * The device this result belongs to, named for every way it occupies —
   * "CB-1,3,5,7 (Welder)". A four-module three-phase RCBO is named for all
   * four even though it accounts for three tests: the fourth module holds its
   * test button and is an occupied way, not another test.
   */
  label String
  /**
   * Which phase this result is, on a device that takes three of them. Kept
   * apart from the label so the device reads the same on all three rows and
   * the phase is its own fact.
   */
  phase String?

  /**
   * Rated residual current in mA, off the tester's own parameters.
   */
  ratingMa Int?
  kind     RcdKind?

  /**
   * Trip times in ms. Null is untested; 2000+ means it did not trip.
   */
  halfAt0    Float?
  halfAt180  Float?
  ratedAt0   Float?
  ratedAt180 Float?
  fiveAt0    Float?
  fiveAt180  Float?

  touchVolts Float?

  /**
   * PASS, CONCERN or FAIL — see lib/rcd/assess.
   */
  verdict String
  /**
   * Why, in the words the report prints.
   */
  reasons String[]

  position Int @default(0)

  @@index([runId])
}

// ---------------------------------------------------------------------------
// Reports
// ---------------------------------------------------------------------------

enum ReportStatus {
  DRAFT
  IN_REVIEW
  ISSUED
}

enum RiskLevel {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

model Report {
  id        String       @id @default(cuid())
  reference String       @unique
  title     String       @default("Electrical inspection report")
  status    ReportStatus @default(DRAFT)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  siteName    String?
  siteAddress String?
  siteContact String?

  inspectionDate DateTime?
  issuedDate     DateTime?

  technicianName    String?
  technicianLicence String?

  // What was covered, in the electrician's words.
  scopeOfWork      String?
  // Auto-drafted then editable by the technician.
  executiveSummary String?
  recommendations  String?
  limitations      String?

  // Conditions on the day — used to sanity-check thermal readings.
  ambientTempC  Float?
  weatherNotes  String?
  equipmentUsed String?

  // Overall rating. Computed from findings unless overridden.
  overallRiskOverride RiskLevel?

  // Which optional sections appear in the finished report.
  includeThermal      Boolean @default(true)
  includeRcd          Boolean @default(true)
  includeObservations Boolean @default(true)
  includePhotos       Boolean @default(true)
  includeGlossary     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thermalFindings ThermalFinding[]
  rcdTests        RcdTest[]
  observations    Observation[]
  photos          Photo[]

  @@index([status])
  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Thermographic findings
// ---------------------------------------------------------------------------

enum ThermalBasis {
  SIMILAR_COMPONENT // ΔT against an equivalent component under similar load
  AMBIENT // ΔT against ambient air temperature
}

model ThermalFinding {
  id        String @id @default(cuid())
  reportId  String
  report    Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  sortOrder Int    @default(0)

  location   String? // e.g. "Main switchboard, Row 2"
  component  String? // e.g. "Circuit 7 — 32 A HRC fuse, A phase"
  loadAmps   Float?
  emissivity Float?  @default(0.95)

  basis          ThermalBasis @default(SIMILAR_COMPONENT)
  measuredTempC  Float?
  referenceTempC Float? // similar component, or ambient, depending on basis

  // Severity is normally derived from ΔT; the technician can override it.
  severityOverride RiskLevel?

  findings          String?
  recommendedAction String?
  clientExplanation String? // Overrides the auto-generated plain-English note.
  rectifiedOnSite   Boolean @default(false)

  thermalImageId String?
  thermalImage   UploadedFile? @relation("ThermalImage", fields: [thermalImageId], references: [id], onDelete: SetNull)
  visualImageId  String?
  visualImage    UploadedFile? @relation("VisualImage", fields: [visualImageId], references: [id], onDelete: SetNull)

  @@index([reportId])
}

// ---------------------------------------------------------------------------
// RCD testing — AS/NZS 3017
// ---------------------------------------------------------------------------

enum RcdKind {
  TYPE_I // ≤ 10 mA
  TYPE_II // ≤ 30 mA
  TYPE_III // > 30 mA
  DELAYED // S-type / time-delayed
}

model RcdTest {
  id        String @id @default(cuid())
  reportId  String
  report    Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  sortOrder Int    @default(0)

  boardName          String?
  circuitDescription String?
  rcdKind            RcdKind @default(TYPE_II)
  ratedCurrentMa     Float   @default(30)
  poles              String? // "2P", "4P", RCBO etc.
  make               String?

  tripTimeRatedMs Float? // at I∆n
  tripTime5xMs    Float? // at 5 × I∆n
  rampTripMa      Float? // current at which it let go
  pushButtonOk    Boolean?
  notRequired     Boolean  @default(false) // e.g. RCD not fitted / not accessible

  resultOverride Boolean? // force pass (true) / fail (false)
  notes          String?

  @@index([reportId])
}

// ---------------------------------------------------------------------------
// General observations / defects
// ---------------------------------------------------------------------------

model Observation {
  id        String @id @default(cuid())
  reportId  String
  report    Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  sortOrder Int    @default(0)

  location          String?
  description       String?
  riskLevel         RiskLevel @default(MEDIUM)
  clauseReference   String? // e.g. "AS/NZS 3000 Cl 2.3.2"
  recommendedAction String?
  clientExplanation String?
  rectifiedOnSite   Boolean   @default(false)

  photoId String?
  photo   UploadedFile? @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@index([reportId])
}

// ---------------------------------------------------------------------------
// Photos, including before/after pairs
// ---------------------------------------------------------------------------

enum PhotoKind {
  BEFORE
  AFTER
  GENERAL
}

model Photo {
  id        String @id @default(cuid())
  reportId  String
  report    Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  sortOrder Int    @default(0)

  kind     PhotoKind @default(GENERAL)
  // Before/after shots of the same thing share a pairKey so they sit side by side.
  pairKey  String?
  title    String?
  caption  String?
  location String?

  fileId String
  file   UploadedFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

// ---------------------------------------------------------------------------
// Safe work paperwork
// ---------------------------------------------------------------------------

/**
 * One of the company's blank SWMS, JSA or WHS templates, held as bytes.
 * They live here rather than in the repository because they carry signatures,
 * and because a template that is revised should be replaced without a deploy.
 * The catalogue in src/lib/safety/catalogue.ts says what each one covers; this
 * holds the file itself.
 */
model SafetyTemplate {
  /**
   * "SWMS014", "JSA001" — the code printed on the document.
   */
  code String @id

  kind     String
  title    String
  /**
   * "pdf" or "docx".
   */
  format   String
  fileName String

  fileId String
  file   UploadedFile @relation("SafetyTemplateFile", fields: [fileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * A signature, kept once and stamped onto whatever needs it.
 * Held as an uploaded file rather than in the repository: a signature is the
 * thing that makes a document binding, and it has no business sitting in
 * source control.
 */
/**
 * What somebody is on a report: an electrician, an apprentice, or both over
 * time. The director is a separate flag because only one person holds it.
 */
enum ProfileTitle {
  ELECTRICIAN
  APPRENTICE
}

/**
 * Somebody who prepares or signs the company's documents.
 * What a person may put their name to depends on what is on file for them. A
 * name and a signature are enough to read and sign a SWMS or a JSA, because
 * that is a record of having read it. Putting your name to a report as the
 * person who carried the work out needs the contractor licence that authorises
 * it; the supervisor certificate is printed beside it where there is one.
 */
model Profile {
  id        String @id @default(cuid())
  firstName String
  lastName  String

  /**
   * NSW electrical contractor licence. Without one: SWMS and JSAs only.
   */
  licence    String?
  /**
   * Qualified supervisor certificate. Always a bonus, never required.
   */
  supervisor String?

  titles   ProfileTitle[]
  /**
   * At most one profile carries this.
   */
  director Boolean        @default(false)

  signatureFileId String?
  signatureFile   UploadedFile? @relation("ProfileSignature", fields: [signatureFileId], references: [id], onDelete: SetNull)

  /**
   * The order they are listed and signed in.
   */
  position Int @default(0)

  /**
   * The gate services they carried out and signed.
   */
  gateServices GateReport[] @relation("GateTechnician")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Signature {
  /**
   * "scott", "kye".
   */
  key      String @id
  name     String
  position String

  fileId String
  file   UploadedFile @relation("SignatureFile", fields: [fileId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

/**
 * One set of paperwork, issued for one job at one site.
 * It holds what the operator answered rather than the finished files: the
 * documents are filled on the way out, so a corrected answer or a revised
 * template is picked up without anything having to be regenerated and stored.
 */
model SafetyDoc {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  date DateTime @default(now()) @db.Date

  /**
   * Template codes chosen, e.g. ["SWMS014", "JSA001"].
   */
  codes String[]

  /**
   * The job details every document asks for.
   */
  projectName    String?
  projectManager String?
  contactNumber  String?

  /**
   * The quote the job description was read from, where one was given.
   */
  sourceFileId    String?
  sourceFile      UploadedFile? @relation("SafetyDocSource", fields: [sourceFileId], references: [id], onDelete: SetNull)
  /**
   * What was read out of it, so a suggestion can be explained afterwards.
   */
  jobDescription  String?
  /**
   * The job's name as the quote gave it.
   */
  jobTitle        String?
  /**
   * What was answered about the work, keyed by question.
   */
  answers         Json?
  /**
   * The quote and the answers written out as one description.
   */
  workDescription String?

  /**
   * The job number this paperwork belongs to. It is written into each
   * document's own project field; the OEC-SWMS00x / OEC-JSA00x identifier
   * printed on the document is never touched.
   */
  jobNumber      String?
  /**
   * When the assessment was actually carried out, which is not necessarily
   * when the record was created and is never assumed to be the day the work
   * happens.
   */
  assessmentDate DateTime? @db.Date
  /**
   * Who has read the documents and agreed to be signed onto them, keyed by
   * person: { scott: { at, name, position } }. A signature is applied to a
   * document only for a person recorded here.
   */
  signOff        Json?
  /**
   * The answers to OEC-WHS002, where the work needs one.
   */
  energised      Json?

  /**
   * What the job is, written once in the operator's own words with whatever
   * paragraphs, dot points and emphasis they used. It becomes a scope of works
   * page in front of every document, and fills the scope panel the SWMS
   * templates leave blank. See `lib/safety/richText.ts`.
   */
  scope          Json?
  /**
   * A different scope for one document, keyed by code, where one document
   * needs to say something the others do not.
   */
  scopeOverrides Json?

  /**
   * The site contact this paperwork is issued against. Their name and phone
   * number are read from the contact record every time a document is built,
   * so correcting the contact corrects the paperwork.
   */
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  createdAt  DateTime @default(now())
  /**
   * The profiles named as having prepared this, in the order they are listed.
   * Empty means the director, which is who it was before this could be chosen.
   */
  preparedBy String[]

  /**
   * The preset this job was started from, and what was typed over the top:
   * `{ selection, edits }`. See `lib/safety/presets.ts`. The wording is
   * composed from the selection every time it is read rather than stored
   * composed, so changing an answer cannot leave an old paragraph behind;
   * only the edits are kept, each against the wording it was an edit of.
   */
  preset Json?

  updatedAt DateTime @updatedAt

  @@index([siteId])
}

/**
 * A preset somebody wrote themselves, to start the next job from.
 * The twenty-four built into `lib/safety/presets.ts` cover the work that
 * comes up; this is for the job that comes up at one client and nowhere else.
 * It holds the same shape as a built-in selection plus the edited wording, so
 * choosing it is indistinguishable from choosing a built-in one.
 */
model SafetyPreset {
  id   String @id @default(cuid())
  name String

  /**
   * `{ presetId, alsoIds, methods, modifierIds }`, as `Selection`.
   */
  selection Json
  /**
   * The edited blocks, keyed by block id: `{ id: { source, text } }`.
   */
  edits     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
}

/**
 * A recommendation written on site, kept for next time.
 * The catalogue in src/lib/issues.ts covers what comes up most, but a board
 * always throws something it does not. Rather than make that a free-text box
 * on every finding — which is how a report ends up with the same sentence
 * typed six different ways — one is written once and offered under its cause
 * from then on, alongside the built-in ones.
 */
model CustomRecommendation {
  id String @id @default(cuid())

  /**
   * The cause it belongs under, e.g. "TERMINAL_CONNECTION".
   */
  cause String
  /**
   * What it says. Stored as written, not as a key.
   */
  text  String

  createdAt DateTime @default(now())

  @@unique([cause, text])
  @@index([cause])
}

/**
 * One power analysis: a logger left on a board and the recording it wrote.
 * The file is kept and re-read when the report is drawn rather than the
 * readings being copied into the database — a fortnight at five-minute
 * intervals is four thousand rows per channel, and the file is the record.
 * Only what the tree needs to show a row is summarised here.
 */
model PowerAnalysis {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  /**
   * The day the recording started, taken from its first timestamp.
   */
  date     DateTime @default(now()) @db.Date
  name     String?
  /**
   * Where the logger was fitted — "Main switchboard".
   */
  location String?

  /**
   * The board it was fitted to, where that board has been drawn on the site.
   */
  equipmentId String?
  equipment   Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)

  /**
   * Why it was recorded: HEADROOM or DRAW. Prints as the objective.
   */
  brief String?

  /**
   * The instrument that took the readings, named on the report.
   */
  instrumentId String?
  instrument   TestEquipment? @relation(fields: [instrumentId], references: [id], onDelete: SetNull)

  /**
   * Who asked for it, named in the objective and as the site contact.
   * Normally one of the site's own contacts; the name is kept as well for
   * somebody who is not on file there.
   */
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactName String?

  /**
   * The logger's own export, kept as it came.
   */
  sourceFileId String?
  sourceFile   UploadedFile? @relation("PowerAnalysisSource", fields: [sourceFileId], references: [id], onDelete: SetNull)

  /**
   * Start, end, interval and the peak on each channel.
   */
  summary Json?

  createdAt  DateTime @default(now())
  /**
   * The profiles named as having prepared this, in the order they are listed.
   * Empty means the director, which is who it was before this could be chosen.
   */
  preparedBy String[]

  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@index([equipmentId])
  @@index([instrumentId])
  @@index([contactId])
}

// ---------------------------------------------------------------------------
// Amp readings
// ---------------------------------------------------------------------------

/**
 * What a protective device's rating belongs to.
 * Kept apart because the two are read differently: a breaker's rating is the
 * current it is there to interrupt, while an RCBO or RCD carries *two* ratings
 * and only one of them is in amps. The other — the residual current it trips
 * on — is in milliamps and has nothing to do with the current recorded here.
 */
enum AmpDevice {
  BREAKER
  RCBO
}

/**
 * Which conductor a recording was taken on.
 * Named as they are called on site. A single-phase circuit is still on one of
 * them, and a clamp round the neutral is a recording of the neutral.
 */
enum AmpPhase {
  RED
  WHITE
  BLUE
  NEUTRAL
}

/**
 * A set of short current recordings, issued as one report.
 * Separate from PowerAnalysis on purpose. That is one logger on one board for a
 * fortnight at five-minute intervals, read for maximum demand; this is a clamp
 * on individual circuits for a minute at a time at one-second intervals, read
 * for what those circuits actually drew while somebody watched them. They share
 * a look and nothing else.
 */
model AmpReport {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  /**
   * The day the readings were taken.
   */
  date DateTime @default(now()) @db.Date
  name String?

  /**
   * Where the readings were taken — "Pit jacks distribution board".
   */
  location String?

  /**
   * The board they were taken at, where that board has been drawn.
   */
  equipmentId String?
  equipment   Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)

  /**
   * Why they were taken, printed at the front of the report.
   */
  purpose String?

  /**
   * The instrument they were taken with, named on the report.
   */
  instrumentId String?
  instrument   TestEquipment? @relation(fields: [instrumentId], references: [id], onDelete: SetNull)

  /**
   * Who asked for them.
   */
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactName String?

  createdAt  DateTime @default(now())
  /**
   * The profiles named as having prepared this, in the order they are listed.
   * Empty means the director, which is who it was before this could be chosen.
   */
  preparedBy String[]

  updatedAt DateTime @updatedAt

  recordings AmpRecording[]

  @@index([siteId])
  @@index([equipmentId])
  @@index([instrumentId])
  @@index([contactId])
}

/**
 * One named recording inside a report — one clamp, on one circuit.
 * The file is kept as it came off the meter and read again whenever the report
 * is drawn; what is stored here is the name it was given, the device it was
 * taken behind, and enough of a summary to describe the row without opening
 * the file again.
 */
model AmpRecording {
  id       String    @id @default(cuid())
  reportId String
  report   AmpReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  /**
   * "A-Phase PIT JACKS" — what it is called wherever it appears.
   */
  name String

  /**
   * The protective device's stated current rating, in amps.
   * Not its trip setting, and never an RCD's residual-current rating in
   * milliamps. Null where none was entered, which is a report of the
   * measurements and no verdict at all.
   */
  rating Float?
  device AmpDevice?

  /**
   * The conductor the clamp went on, where it was said.
   */
  phase AmpPhase?

  /**
   * The section of the report this recording belongs to, where it is in one.
   * Three phases of the one board are three recordings and belong together
   * under the board's name; a recording off somewhere else stands on its own.
   * Recordings sharing a name share a section, which is numbered where a
   * standalone recording would be and lists its own under a, b, c.
   */
  groupName String?

  /**
   * The meter's own export, kept byte for byte.
   */
  fileId String
  file   UploadedFile @relation("AmpRecordingSource", fields: [fileId], references: [id], onDelete: Cascade)

  /**
   * Hand-ordered within the report.
   */
  position Int @default(0)

  /**
   * Count, period, highest, average — for the dialog and the tree.
   */
  summary Json?

  createdAt DateTime @default(now())

  @@index([reportId])
  @@index([fileId])
}

/**
 * ===========================================================================
 * Test and tag
 * ===========================================================================
 */

/**
 * The reference spreadsheet behind our own equipment register.
 * One row, like Settings, because there is one truck's worth of gear and one
 * export of it. Replacing the file changes what the next report is made from
 * and nothing else: a report already generated holds its own copy of the rows
 * it was made from, so last month's register still says what it said.
 */
model TaggingSettings {
  id String @id @default("singleton")

  fileId String?
  file   UploadedFile? @relation("TaggingReference", fields: [fileId], references: [id], onDelete: SetNull)

  /**
   * When the file on it was last replaced, for saying how old it is.
   */
  uploadedAt DateTime?
  updatedAt  DateTime  @updatedAt
}

enum TagReportKind {
  /**
   * Our own gear, out of the reference file.
   */
  INTERNAL
  /**
   * A client's gear, out of the file uploaded for this report.
   */
  CLIENT
}

/**
 * One generated register, kept so it can be reopened and downloaded again.
 * The rows are stored on the report rather than read back off a file, because
 * the file they came from is replaced and a report that changed when the
 * reference was replaced would not be a record of anything. The spreadsheet is
 * kept beside them all the same, so the original is always recoverable.
 */
model TagReport {
  id   String        @id @default(cuid())
  kind TagReportKind

  /**
   * A client report belongs to a site; our own register belongs to nobody.
   */
  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  /**
   * The day it is issued. Editable, and never an item's test date.
   */
  date DateTime @default(now()) @db.Date
  name String?

  /**
   * The spreadsheet it was made from, kept byte for byte.
   */
  sourceId String?
  source   UploadedFile? @relation("TagReportSource", fields: [sourceId], references: [id], onDelete: SetNull)

  /**
   * The rows as they were read, so the report never changes under anyone.
   */
  items Json

  /**
   * What is in them, counted once.
   * Kept beside the rows rather than counted out of them, so the navigation
   * can say "22 items · 2 failed" without loading every row of every report
   * on the site. They describe the stored rows and so never change either.
   */
  itemCount   Int @default(0)
  passCount   Int @default(0)
  failCount   Int @default(0)
  reviewCount Int @default(0)

  /**
   * Which customer and site out of the file this report is about.
   */
  customer  String?
  siteLabel String?

  /**
   * Anything the reader wanted said about the file.
   */
  notes String[]

  preparedBy String[]

  createdAt DateTime @default(now())

  @@index([siteId])
  @@index([kind, date])
}

/**
 * ===========================================================================
 * Gate servicing
 * ===========================================================================
 */

enum GateKind {
  BOOM
  SLIDING
}

enum GateServiceKind {
  SCHEDULED
  BREAKDOWN
  FOLLOW_UP
}

enum GateOutcome {
  RETURNED
  RETURNED_WITH_DEFECTS
  ISOLATED
}

/**
 * A gate that will be serviced again, saved so it is described once.
 * The stable half of a service report — what the unit is, where it is, what is
 * fitted to it — belongs to the gate, not to the visit. Saving it here means
 * the next visit starts with the asset already described and the technician
 * answering only what happened on the day.
 * What is deliberately NOT here is anything that was true once: a result, a
 * measurement, a signature, a fault. Carrying those forward would present last
 * year's pass as this year's, which is the one thing a service record must
 * never do. A follow-up report may quote a previous defect, but it quotes it
 * as an open question about today rather than as a finding of today.
 */
model GateAsset {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  /**
   * How it is known on site. Unique within the site where it is given.
   */
  assetNumber  String?
  gateLocation String?
  kind         GateKind @default(BOOM)

  model              String?
  serialNumber       String?
  controllerModel    String?
  controllerFirmware String?
  armLengthMetres    Float?

  accessories    String[]
  accessoryNotes String?
  manualRef      String?

  /**
   * The last report issued against it, so a follow-up can cite it.
   */
  previousService String?

  /**
   * Kept out of the pickers without losing the reports that cite it.
   */
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports GateReport[] @relation("GateAssetReports")

  @@index([siteId])
}

/**
 * One gate, serviced once.
 * One report per unit, which is why the asset details are on the report rather
 * than on a separate record: two barriers on the one site are two reports, and
 * the second one's serial number is not a variation of the first's.
 * Almost everything is nullable. A service report is filled in on site, on a
 * phone, in the order the work happens, and a form that refuses to save until
 * it is finished is a form that loses an afternoon's work when the battery
 * goes. What it needs before it is finished is worked out when it is read, not
 * enforced on every save.
 */
model GateReport {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  /**
   * The day it was serviced. Drives the technician date and the next due.
   */
  date        DateTime  @default(now()) @db.Date
  /**
   * Recorded when the technician signs it off.
   */
  completedAt DateTime?

  /**
   * --- the asset ----------------------------------------------------------
   */

  /**
   * The saved gate this is a visit to, where one was chosen.
   * The details below are still written onto the report rather than read
   * through this relation: an asset edited next year must not change what a
   * report said this year. The relation records which gate it was.
   */
  assetId String?
  asset   GateAsset? @relation("GateAssetReports", fields: [assetId], references: [id], onDelete: SetNull)

  kind         GateKind @default(BOOM)
  gateLocation String?
  assetNumber  String?
  jobNumber    String?
  reportNumber String?

  /**
   * The operator, not the controller. "GIOTTO BT A ULTRA 36 XL".
   */
  model              String?
  serialNumber       String?
  /**
   * The board inside it, which is a different thing from the operator.
   */
  controllerModel    String?
  controllerFirmware String?

  /**
   * Boom gates only. Metres, fractional allowed.
   */
  armLengthMetres Float?

  /**
   * Which of the fitted accessories are on it, and anything else.
   */
  accessories    String[]
  accessoryNotes String?

  previousService String?
  reportedFaults  String?

  /**
   * --- preparation ---------------------------------------------------------
   */

  serviceKind GateServiceKind @default(SCHEDULED)
  weather     String?
  /**
   * Which preparation items the technician confirmed. Never ticked for them.
   */
  preparation String[]
  manualRef   String?

  /**
   * --- the inspection ------------------------------------------------------
   */

  /**
   * { itemId: { result, note } } for every item that has been answered.
   */
  answers Json?

  /**
   * --- measurements and service work ---------------------------------------
   */

  supplyVoltage  String?
  earthTest      String?
  balanceNotes   String?
  lubrication    String?
  partsReplaced  String?
  testInstrument String?

  openingTime      String?
  closingTime      String?
  autoCloseDelay   String?
  finalCycles      String?
  controllerErrors String?
  safetyMethod     String?
  forceEquipment   String?

  workCompleted   String?
  recommendations String?
  photoReferences String?

  /**
   * [{ ref, finding, priority, action, fromItem }]
   */
  defects Json?

  /**
   * --- the outcome ---------------------------------------------------------
   */

  outcome           GateOutcome?
  outcomeNotes      String?
  notifiedContactId String?
  notifiedContact   Contact?     @relation("GateNotified", fields: [notifiedContactId], references: [id], onDelete: SetNull)
  notifiedTime      String?

  nextServiceDue DateTime? @db.Date
  intervalBasis  String?

  /**
   * --- who -----------------------------------------------------------------
   */

  /**
   * The technician, from Profiles: their name, credentials and signature.
   */
  technicianId String?
  technician   Profile? @relation("GateTechnician", fields: [technicianId], references: [id], onDelete: SetNull)

  /**
   * The client representative the findings were handed to. Name only.
   */
  clientContactId String?
  clientContact   Contact? @relation("GateClientRep", fields: [clientContactId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * The scenario this report was started from, and the edits made to its
   * wording: `{ scenarioId, edits }`. See `lib/gates/presets.ts`.
   */
  preset Json?

  photos GatePhoto[]

  @@index([siteId])
  @@index([date])
}

/**
 * A photograph taken on the visit, referenced from the report.
 */
model GatePhoto {
  id       String     @id @default(cuid())
  reportId String
  report   GateReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  fileId String
  file   UploadedFile @relation("GatePhoto", fields: [fileId], references: [id], onDelete: Cascade)

  caption  String?
  position Int     @default(0)

  @@index([reportId])
}

/**
 * ===========================================================================
 * Installation testing
 * ===========================================================================
 */

enum InstallPhases {
  SINGLE
  THREE
}

/**
 * One installation, tested once.
 * The tester's export is read when it is uploaded and the rows are kept on the
 * report, so a report says the same thing next year as it says today. The file
 * itself is kept too and is bound into the back of the report, exactly as the
 * RCD report binds its own.
 * Nothing in here edits a reading. `exclusions` sets a record aside — out of
 * the points and the figures, into its own section, still in the appended
 * original, and put back by taking the exclusion off.
 */
model InstallReport {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  date DateTime @default(now()) @db.Date
  name String?

  /**
   * Which decides how many insulation and RCD records the scope expects.
   */
  phases InstallPhases @default(SINGLE)

  /**
   * The tester's own export, kept byte for byte and appended to the report.
   */
  sourceId String?
  source   UploadedFile? @relation("InstallSource", fields: [sourceId], references: [id], onDelete: SetNull)

  /**
   * The rows as they were read, so the report never changes under anyone.
   */
  rows Json

  /**
   * How many records the file held, counted once.
   * Kept beside the rows so the navigation can say what is in a report without
   * loading every reading of every report on the site. It describes the stored
   * rows, so like them it never changes.
   */
  recordCount Int @default(0)

  /**
   * What the export said about itself: title, site, board, created.
   */
  header Json?

  /**
   * { "S_2": "Powerpoint 1" } — what the operator called each point.
   */
  pointNames Json?

  /**
   * [{ name, reason }] — records set aside, never deleted.
   */
  exclusions Json?

  /**
   * { "S_1": "Kitchen sub-circuit" } — which circuit a record belongs to.
   */
  circuits Json?

  /**
   * What was being tested, printed on the cover.
   */
  installation   String?
  circuitDetails String?

  contactId String?
  contact   Contact? @relation("InstallContact", fields: [contactId], references: [id], onDelete: SetNull)

  instrumentId String?
  instrument   TestEquipment? @relation("InstallInstrument", fields: [instrumentId], references: [id], onDelete: SetNull)

  preparedBy String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@index([date])
}
