# --- Required ---------------------------------------------------------------

# The password everyone types on the OptiLink front page.
# Falls back to "123" if left unset, so a fresh deploy can be opened.
APP_PASSWORD="change-me-to-something-long"

# Secret used to sign the login cookie. Any long random string.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string"

# Postgres connection string. On Railway, add a Postgres database and this is
# injected for you as ${{Postgres.DATABASE_URL}}.
DATABASE_URL="postgresql://user:password@localhost:5432/optilink"

# --- Optional ---------------------------------------------------------------

# Where uploaded photos are written. On Railway, attach a Volume and mount it
# at /data, then set this to /data/uploads.
UPLOAD_DIR="./uploads"

# How long a login lasts before it has to be re-entered, in hours.
SESSION_HOURS="72"
